<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Poster.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3E91FF" RegionColor="#FFFFFF" ErrorText="#E5484D" />
        <ColorPaletteResources x:Key="Dark" Accent="#3E91FF" RegionColor="#1C1C1E" ErrorText="#FF6369" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Themes/OneUi/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/OneUi/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
