<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One UI design tokens: shape, spacing and colour.
       Light/dark values are mapped onto Fluent's own resource keys at the bottom of each
       theme dictionary, so every standard control picks them up without re-templating. -->

  <CornerRadius x:Key="ControlCornerRadius">20</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">24</CornerRadius>
  <CornerRadius x:Key="OneUiCardRadius">28</CornerRadius>
  <CornerRadius x:Key="OneUiPillRadius">24</CornerRadius>
  <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
  <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
  <x:Double x:Key="ControlContentThemeFontSize">15</x:Double>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="OneUiTransparent" Color="Transparent" />
      <SolidColorBrush x:Key="OneUiBackground" Color="#F6F6F8" />
      <SolidColorBrush x:Key="OneUiCard" Color="#FFFFFF" />
